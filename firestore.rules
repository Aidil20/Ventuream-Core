rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Master Catch-all Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PRIMITIVES ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Role checks
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isPresidentDirector() {
      return isSignedIn() && getUserRole() == 'President_Director';
    }

    function isManager() {
      return isSignedIn() && (getUserRole() == 'Manager' || getUserRole() == 'President_Director');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- ENTITY VALIDATIONS ---
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'updatedAt'])
        && data.keys().size() == 5
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.displayName is string && data.displayName.size() <= 100
        && data.role in ['Public', 'Analyst', 'Trader', 'Manager', 'President_Director']
        && data.updatedAt is timestamp;
    }

    // --- MATCH BLOCKS ---
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || isManager());
      allow list: if isSignedIn() && isManager();
      
      allow create: if isSignedIn() 
        && isValidId(userId)
        && userId == request.auth.uid
        && isValidUser(incoming())
        && incoming().uid == request.auth.uid
        && (incoming().role == 'Public' || (incoming().role == 'President_Director' && (incoming().email == 'aidilsyahdan2000@gmail.com' || incoming().email == 'pt.ventuream@gmail.com')))
        && incoming().updatedAt == request.time;
        
      allow update: if isSignedIn()
        && isValidId(userId)
        && isValidUser(incoming())
        && incoming().updatedAt == request.time
        && (
          // Action: Profile Update (Self)
          (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) && incoming().uid == existing().uid && incoming().email == existing().email && incoming().role == existing().role) ||
          // Action: Self-Promotion for designated admins
          (isOwner(userId) && (incoming().email == 'aidilsyahdan2000@gmail.com' || incoming().email == 'pt.ventuream@gmail.com') && incoming().role == 'President_Director' && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']) && incoming().uid == existing().uid && incoming().email == existing().email) ||
          // Action: Role Assignment (President Director)
          (isPresidentDirector() && incoming().diff(existing()).affectedKeys().hasOnly(['role', 'updatedAt']) && incoming().uid == existing().uid && incoming().email == existing().email)
        );
        
      allow delete: if false;
    }
  }
}
